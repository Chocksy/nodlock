# Copy to .env (plain Docker) or paste into Coolify's Environment Variables.

# Required. Same value as OPG_SERVER_TOKEN on the Mac. Make one: openssl rand -hex 16
NODLOCK_TOKEN=
# Required on first start. Tailscale auth key, reusable, tagged tag:nodlock.
TS_AUTHKEY=
# Required unless Apple push is set up. A long random name nobody can guess.
NTFY_TOPIC=

# Optional.
# NTFY_URL=https://ntfy.sh
# NTFY_TOKEN=
# CHECK_INTERVAL=300
# SILENCE_MINUTES=10
# TZ=Europe/Bucharest

# Optional Apple push (needs secrets/AuthKey_<KEY_ID>.p8).
# OPG_APNS_KEY_ID=
# OPG_APNS_TEAM_ID=
