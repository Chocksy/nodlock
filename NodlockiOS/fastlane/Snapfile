# fastlane Snapfile — Nodlock (iOS)
# Docs: https://docs.fastlane.tools/actions/snapshot/
#
# Drives NodlockUITests/ScreenshotTests.swift through the app's demo mode and
# drops raw captures into ../appstore/screenshots/raw. appstore/make_shots.py
# then composites those into captioned, exact-size App Store assets.

devices([
  "iPhone 17 Pro Max",   # 1320x2868 -> the 6.9" slot Apple requires
  "iPhone 11 Pro Max"    # 1242x2688 -> the 6.5" slot
])

languages(["en-US"])

scheme("Nodlock")

output_directory("../appstore/screenshots/raw")
clear_previous_screenshots(true)

override_status_bar(true)
erase_simulator(true)
dark_mode(true)
stop_after_first_error(true)

# Run one device at a time. Driving two destinations from a single xcodebuild
# invocation raced the simulator boot and failed the test runner install with
# "Mach error -308 - (ipc/mig) server died".
concurrent_simulators(false)

# --- simulator biometrics -----------------------------------------------------
# BiometricGate calls LAContext.evaluatePolicy(.deviceOwnerAuthentication). On the
# iOS 26 simulator canEvaluatePolicy returns true even with nothing enrolled, and
# evaluatePolicy then never calls back: no sheet, no callback, and the gate sits
# on "Nodlock is locked" forever. Keeping every booted simulator enrolled and
# feeding it match events resolves the evaluation so the demo can proceed.
Thread.new do
  loop do
    begin
      `xcrun simctl list devices booted -j 2>/dev/null`
        .scan(/"udid"\s*:\s*"([^"]+)"/).flatten.each do |udid|
        system("xcrun simctl spawn #{udid} notifyutil -s com.apple.BiometricKit.enrollmentChanged 1 > /dev/null 2>&1")
        system("xcrun simctl spawn #{udid} notifyutil -p com.apple.BiometricKit.enrollmentChanged > /dev/null 2>&1")
        system("xcrun simctl spawn #{udid} notifyutil -p com.apple.BiometricKit_Sim.pearl.match > /dev/null 2>&1")
      end
    rescue StandardError
      # never let the helper take the run down
    end
    # Slow on purpose: the gate has to stay up long enough for the test to
    # photograph it (03-faceid) before a match event dismisses it.
    sleep 5
  end
end
