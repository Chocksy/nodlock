# fastlane Fastfile — Nodlock (iOS)
#
# App:        Nodlock
# Bundle id:  $SENTINEL_BUNDLE_ID (from NodlockiOS/.env)
# Scheme:     Nodlock   (Xcode project is generated by ../gen.sh via xcodegen)
# Team:       $SENTINEL_TEAM_ID (from NodlockiOS/.env)
#
# ---------------------------------------------------------------------------
# AUTHENTICATION — App Store Connect API key (3 env vars)
# ---------------------------------------------------------------------------
# Every lane that talks to Apple uses an App Store Connect API key instead of an
# Apple ID + password + 2FA session. It never expires on a 30-day timer and it
# works unattended in CI.
#
#   ASC_KEY_ID     the 10-character Key ID, e.g. "ABC123DEFG"
#   ASC_ISSUER_ID  the issuer UUID, e.g. "12ab34cd-56ef-78ab-90cd-1234ef567890"
#   ASC_KEY_PATH   absolute path to the downloaded .p8 file, e.g.
#                  ~/.config/op-guard/asc/AuthKey_ABC123DEFG.p8
#
# How to create the key:
#   1. Sign in to App Store Connect as an Account Holder or Admin.
#   2. Users and Access -> Integrations -> App Store Connect API -> Team Keys.
#   3. Click "+", name it (e.g. "nodlock-fastlane"), pick access role
#      "App Manager". App Manager can edit metadata, upload builds and submit
#      for review, which is everything these lanes need.
#   4. Generate, then download the .p8 file. Apple lets you download it ONCE.
#   5. Copy the Key ID from the table and the Issuer ID from the top of the page.
#   6. Store the .p8 outside the repo:
#        mkdir -p ~/.config/op-guard/asc
#        mv ~/Downloads/AuthKey_ABC123DEFG.p8 ~/.config/op-guard/asc/
#        chmod 600 ~/.config/op-guard/asc/AuthKey_ABC123DEFG.p8
#   7. Put the three vars in ~/.config/op-guard/asc.env and `source` it before
#      running a lane. See README-fastlane.md.
#
# The .p8 is a private key. Never commit it, never put it in the repo tree.
# ---------------------------------------------------------------------------

default_platform(:ios)

APP_SCHEME  = "Nodlock"
APP_PROJECT = "Nodlock.xcodeproj"


# Overlay gitignored personal review-contact files (metadata.local/) before deliver runs.
before_all do
  local = File.expand_path("metadata.local", __dir__)
  if Dir.exist?(local)
    require "fileutils"
    Dir.glob("#{local}/**/*.txt").each do |f|
      FileUtils.cp(f, f.sub("metadata.local", "metadata"))
    end
  end
end

platform :ios do
  before_all do
    # setup_ci creates a temporary keychain so code signing works on a CI box.
    # Skipped on a developer Mac, where the login keychain is already there.
    setup_ci if ENV["CI"]
  end

  # Loads the App Store Connect API key from the three env vars. Fails loudly
  # and early if any of them is missing, so a lane never half-runs.
  def asc_api_key
    missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].reject { |k| ENV[k].to_s.strip != "" }
    unless missing.empty?
      UI.user_error!(
        "Missing App Store Connect API key env vars: #{missing.join(', ')}.\n" \
        "Run: source ~/.config/op-guard/asc.env   (see fastlane/README-fastlane.md)"
      )
    end

    key_path = File.expand_path(ENV["ASC_KEY_PATH"])
    UI.user_error!("ASC_KEY_PATH points at a file that does not exist: #{key_path}") unless File.exist?(key_path)

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )
  end

  desc "Upload App Store metadata, review notes and screenshots. No binary."
  desc "Run `fastlane precheck_local` first. Requires ASC_* env vars."
  lane :metadata do
    api_key = asc_api_key

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  desc "Build the app and upload it to TestFlight (internal testers only)."
  lane :beta do
    api_key = asc_api_key

    gym(
      scheme: APP_SCHEME,
      project: APP_PROJECT,
      export_method: "app-store",
      include_bitcode: false,
      clean: true
    )

    pilot(
      api_key: api_key,
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      skip_submission: false
    )
  end

  desc "Build, upload the binary, upload metadata and submit for App Store review."
  desc "Release stays manual: automatic_release is false, so you press the button."
  lane :release do
    api_key = asc_api_key

    gym(
      scheme: APP_SCHEME,
      project: APP_PROJECT,
      export_method: "app-store",
      include_bitcode: false,
      clean: true
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: false,
      skip_screenshots: false,
      skip_metadata: false,
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end

  desc "Offline metadata check. Verifies every required file exists and fits"
  desc "Apple's character limits. Makes no network calls, needs no credentials."
  lane :precheck_local do
    metadata_dir = File.expand_path("metadata", __dir__)
    screenshot_dir = File.expand_path("screenshots", __dir__)

    # relative path => Apple's maximum character count
    limits = {
      "en-US/name.txt"                        => 30,
      "en-US/subtitle.txt"                    => 30,
      "en-US/promotional_text.txt"            => 170,
      "en-US/description.txt"                 => 4000,
      "en-US/keywords.txt"                    => 100,
      "en-US/release_notes.txt"               => 4000,
      "en-US/support_url.txt"                 => 255,
      "en-US/marketing_url.txt"               => 255,
      "en-US/privacy_url.txt"                 => 255,
      "primary_category.txt"                  => 64,
      "secondary_category.txt"                => 64,
      "copyright.txt"                         => 100,
      "review_information/notes.txt"          => 4000,
      "review_information/first_name.txt"     => 50,
      "review_information/last_name.txt"      => 50,
      "review_information/email_address.txt"  => 255,
      "review_information/phone_number.txt"   => 50
    }

    # Must exist, must be empty: Nodlock has no login, so no demo account.
    must_be_empty = %w[
      review_information/demo_user.txt
      review_information/demo_password.txt
    ]

    rows = []
    problems = []

    limits.each do |rel, max|
      path = File.join(metadata_dir, rel)

      unless File.exist?(path)
        rows << [rel, "-", max.to_s, "MISSING"]
        problems << "#{rel} is missing"
        next
      end

      text = File.read(path, encoding: "UTF-8").strip
      len = text.length

      if len.zero?
        rows << [rel, "0", max.to_s, "EMPTY"]
        problems << "#{rel} is empty"
      elsif len > max
        rows << [rel, len.to_s, max.to_s, "OVER by #{len - max}"]
        problems << "#{rel} is #{len - max} characters over the #{max} limit"
      else
        rows << [rel, len.to_s, max.to_s, "ok"]
      end
    end

    must_be_empty.each do |rel|
      path = File.join(metadata_dir, rel)

      unless File.exist?(path)
        rows << [rel, "-", "0", "MISSING"]
        problems << "#{rel} is missing (create it empty: no demo account needed)"
        next
      end

      len = File.read(path, encoding: "UTF-8").strip.length
      if len.zero?
        rows << [rel, "0", "0", "ok (empty)"]
      else
        rows << [rel, len.to_s, "0", "SHOULD BE EMPTY"]
        problems << "#{rel} must be empty: the app requires no sign-in"
      end
    end

    # Screenshots are dropped in later, so a missing set is a warning not a failure.
    shots = Dir.glob(File.join(screenshot_dir, "en-US", "*.{png,jpg,jpeg,PNG,JPG,JPEG}"))
    rows << ["screenshots/en-US/", shots.count.to_s, "n/a", shots.empty? ? "warn: none yet" : "ok"]

    # ---- print the table -------------------------------------------------
    headers = %w[FILE CHARS LIMIT STATUS]
    widths = headers.each_with_index.map do |h, i|
      ([h.length] + rows.map { |r| r[i].length }).max
    end
    line = "+" + widths.map { |w| "-" * (w + 2) }.join("+") + "+"
    fmt = ->(cells) { "| " + cells.each_with_index.map { |c, i| c.ljust(widths[i]) }.join(" | ") + " |" }

    puts ""
    puts "Nodlock metadata precheck (offline)"
    puts line
    puts fmt.call(headers)
    puts line
    rows.each { |r| puts fmt.call(r) }
    puts line
    puts ""

    if problems.empty?
      UI.success("precheck_local passed: #{limits.count + must_be_empty.count} metadata files present and within Apple's limits.")
      UI.important("No screenshots in fastlane/screenshots/en-US yet. Add them before running `fastlane metadata`.") if shots.empty?
    else
      problems.each { |p| UI.error(p) }
      UI.user_error!("precheck_local failed with #{problems.count} problem(s). See the table above.")
    end
  end
end
